                    "values": {
                        "actorHeroId": "black-widow",
                        "targetSideCode": "PLAYER"
                    },
                    "narrative": {
                        "lines": [
                            {
                                "type": "NARRATION",
                                "speakerId": null,
                                "text": "The Player Team lowers its weapons.",
                                "lineSequence": 1
                            },
                            {
                                "type": "DIALOGUE",
                                "speakerId": "silver-surfer",
                                "text": "Is that all? After everything you sacrificed to come this far?",
                                "lineSequence": 2
                            },
                            {
                                "type": "DIALOGUE",
                                "speakerId": "black-widow",
                                "text": "There will be no more battle. It's over.",
                                "lineSequence": 3
                            },
                            {
                                "type": "NARRATION",
                                "speakerId": null,
                                "text": "Silver Surfer remains still. For the first time, he smiles.",
                                "lineSequence": 4
                            },
                            {
                                "type": "DIALOGUE",
                                "speakerId": "silver-surfer",
                                "text": "Yes. For you.",
                                "lineSequence": 5
                            },
                            {
                                "type": "NARRATION",
                                "speakerId": null,
                                "text": "The silver light fades. Green and steel armor emerges.",
                                "lineSequence": 6
                            },
                            {
                                "type": "DIALOGUE",
                                "speakerId": "doctor-doom",
                                "text": "You came farther than entire worlds... and chose to walk away when the moment came to decide their fate.",
                                "lineSequence": 7
                            },
                            {
                                "type": "DIALOGUE",
                                "speakerId": "black-widow",
                                "text": "Doom...",
                                "lineSequence": 8
                            },
                            {
                                "type": "DIALOGUE",
                                "speakerId": "doctor-doom",
                                "text": "Go. History has little use for those who abandon it.",
                                "lineSequence": 9
                            },
                            {
                                "type": "NARRATION",
                                "speakerId": null,
                                "text": "Doom raises one hand. A green glow surrounds the Player Team.",
                                "lineSequence": 10
                            },
                            {
                                "type": "DIALOGUE",
                                "speakerId": "black-widow",
                                "text": "What are you doing?",
                                "lineSequence": 11
                            },
                            {
                                "type": "NARRATION",
                                "speakerId": null,
                                "text": "The heroes try to resist, but Doom's energy closes around them. Their bodies begin to fade in green light.",
                                "lineSequence": 12
                            },
                            {
                                "type": "DIALOGUE",
                                "speakerId": "black-widow",
                                "text": "Doom...!",
                                "lineSequence": 13
                            },
                            {
                                "type": "NARRATION",
                                "speakerId": null,
                                "text": "One by one, they disappear, never learning what will happen to those left behind.",
                                "lineSequence": 14
                            },
                            {
                                "type": "NARRATION",
                                "speakerId": null,
                                "text": "The last image they see is Doom standing before the gathered realities.",
                                "lineSequence": 15
                            },
                            {
                                "type": "DIALOGUE",
                                "speakerId": "doctor-doom",
                                "text": "The multiverse will continue. It simply will do so without you.",
                                "lineSequence": 16
                            },
                            {
                                "type": "NARRATION",
                                "speakerId": null,
                                "text": "THE BATTLE CONTINUES WITHOUT YOU.",
                                "lineSequence": 17
                            }
                        ]
